import numpy as np


# 3.1

list = [20, 27, 9, 12, 31, 17, 4, 50, 39, 35]

arr = np.array(list)
arr_x4 = arr * 4
print(arr_x4)

mean_val = np.mean(arr)
print(mean_val)

median_val = np.median(arr)
print(median_val)

std_val = np.std(arr)
print(std_val)

min_index = np.argmin(arr)
max_index = np.argmax(arr)
print(min_index)
print(max_index)

print(arr[min_index])
print(arr[max_index])

